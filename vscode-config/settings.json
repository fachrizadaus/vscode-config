{
    "workbench.iconTheme": "catppuccin-frappe",
    "workbench.colorTheme": "Vesper",
    "workbench.productIconTheme": "fluent-icons",
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "top",
    "workbench.statusBar.visible": false,
    "editor.accessibilitySupport": "off",
    "editor.fontFamily": "Geist Mono, JetBrains Mono, Cascadia Code, Fira Code, monospace",
    "editor.fontLigatures": true,
    "editor.formatOnPaste": true,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.wordWrap": "off",
    "editor.minimap.enabled": false,
    "editor.minimap.showSlider": "always",
    "editor.cursorBlinking": "expand",
    "editor.snippetSuggestions": "top",
    "editor.lineHeight": 40,
    "editor.fontSize": 14,
    "editor.scrollbar.verticalScrollbarSize": 10,
    "editor.scrollbar.horizontalScrollbarSize": 10,
    "editor.gotoLocation.multipleReferences": "gotoAndPeek",
    "editor.foldingHighlight": false,
    "editor.stickyScroll.enabled": false,
    "editor.multiCursorLimit": 100000,
    "diffEditor.ignoreTrimWhitespace": true,
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontFamily": "Fira Code",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.scrollback": 9999999,
    "window.commandCenter": true,
    "git.ignoreRebaseWarning": true,
    "html.format.wrapLineLength": 250,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "database-client.autoSync": true
}